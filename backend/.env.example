# ==============================================================================
# TaskForge Backend - Environment Variables Configuration
# ==============================================================================

# Server Environment & Port (Render sets PORT automatically)
NODE_ENV=production
PORT=5000

# CORS Allowed Origin (Set to your deployed Netlify/Vercel frontend URL in production)
# Supports single URL, comma-separated URLs, or *
FRONTEND_URL=https://your-app.netlify.app

# Database Connection (MySQL / Aiven Cloud)
DB_HOST=mysql-1a40b90e-taskforge.f.aivencloud.com
DB_PORT=16783
DB_USER=avnadmin
DB_PASSWORD=your_mysql_database_password_here
DB_NAME=defaultdb

# SSL Configuration for Cloud Hosted MySQL (e.g. Aiven, AWS RDS)
DB_SSL=true
DB_SSL_CA=certs/ca.pem
# Optional: Paste full raw CA PEM content directly in cloud dashboards (Render)
# DB_SSL_CA_CERT=

# JWT Authentication Configuration (Required in production)
JWT_SECRET=your_super_strong_random_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d
